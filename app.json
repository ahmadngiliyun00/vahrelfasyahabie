{
  "expo": {
    "name": "Git Gud",
    "slug": "gitgud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "ac.id.mahardika.gitgud"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "universitas-insan-mahardika",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ]
    ]
  }
}
